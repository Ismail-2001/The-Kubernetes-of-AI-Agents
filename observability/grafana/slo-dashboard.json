      "title": "Availability SLO (99.9% Target)",
      "type": "stat",
      "targets": [
        {
          "expr": "100 * (1 - (sum(rate(http_requests_total{job=\"egaop-services\", code=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{job=\"egaop-services\"}[$__rate_interval]))))",
          "legendFormat": "Current Availability",
          "refId": "A"
        },
        {
          "expr": "99.9",
          "legendFormat": "Target (99.9%)",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 400 }, { "color": "green", "value": 500 }] },
